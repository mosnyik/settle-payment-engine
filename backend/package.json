
{
  "name": "payment-engine",
  "version": "1.0.0",
  "description": "2Settle Payment Engine - Standalone Express API",
  "main": "dist/index.js",
  "scripts": {
    "backfill:transaction-usd": "node scripts/backfill-transaction-usd.js",
    "copy:missing-settled-payment-sessions": "node scripts/copy-missing-settled-payment-sessions.js",
    "dev": "tsx watch src/index.ts",
    "docs:pdf": "node scripts/markdown-to-pdf.js",
    "build": "tsc && node scripts/copy-assets.js",
    "generate:gift-ids": "tsx scripts/generate-gift-ids.ts",
    "recover": "tsx scripts/recover-stuck-hd-sweep.ts",
    "recover:hd-sweep": "tsx scripts/recover-stuck-hd-sweep.ts",
    "report:successful-payments": "node scripts/successful-payments-report.js",
    "report:transaction-overhead": "node scripts/transaction-overhead-report.js",
    "start": "node dist/index.js",
    "sync:paystack-banks": "tsx scripts/sync-paystack-banks.ts",
    "update:gift-fields-by-amount": "node scripts/update-gift-fields-by-amount.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:google-login": "node scripts/google-login-test/server.js",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@scure/btc-signer": "^2.0.1",
    "axios": "^1.7.8",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.5",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "tronweb": "^6.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/connect-timeout": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.29.3"
}
